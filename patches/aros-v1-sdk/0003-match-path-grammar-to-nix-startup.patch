+    result = {"source_manifest_sha256": digest(HERE / "source-files.json"), "native_inputs": frozen_native, "profile": profile, "official_compiler": str(compiler), "official_cargo": cargo, "build_jobs": args.jobs, "std_rustflags": std_rustflags(output, sources, args.cc_arg), "path_mode": "nix" if "-nix" in args.cc_arg else "amigados", "probe": args.probe, "probe_sha256": digest(probe_source),
               "precompiled_std": {p.name: digest(p) for p in std_rlibs},
               "compiler_commit": COMMIT, "compiler_sha256": compiler_sha256,
               "target_sha256": digest(target), "std_patch_sha256": digest(HERE / "rust-src-aros.diff"),
@@ -298,7 +302,8 @@ def main():
