From e81cc1e07a0e8d912138b06a2d78cbaa6bbbc9fa Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sat, 24 Oct 2026 12:34:43 +0200
Subject: [PATCH] rust: remap source paths while compiling the standard library

---
 tools/crosstools/rust/unmodified/build.py     | 16 ++++++++--
 .../rust/unmodified/test-source-paths.py      | 29 +++++++++++++++++++
 2 files changed, 43 insertions(+), 2 deletions(-)
 create mode 100644 tools/crosstools/rust/unmodified/test-source-paths.py

diff --git a/tools/crosstools/rust/unmodified/build.py b/tools/crosstools/rust/unmodified/build.py
index b1b9c671..0d371577 100644
--- a/tools/crosstools/rust/unmodified/build.py
+++ b/tools/crosstools/rust/unmodified/build.py
@@ -42,6 +42,18 @@ def run(command, *, cwd=None, env=None, log=None):
 MIN_BUILD_FREE = 6 * 1024**3
 
 
+def std_rustflags(output, sources):
+    """Keep source locations useful without embedding workstation directories.
+
+    The more specific mapping is last because rustc checks mappings in reverse
+    order. This applies while compiling std, before file! and panic locations
+    become constants in the installed rlibs.
+    """
+    return ["-C", "embed-bitcode=yes",
+            "--remap-path-prefix=" + str(output) + "=/aros-build",
+            "--remap-path-prefix=" + str(sources) + "=/rust-src"]
+
+
 def std_build_command(cargo, sources, manifest, target, jobs):
     """Construct the bounded offline build; do not inherit ambient Cargo jobs."""
     if jobs < 1:
@@ -158,7 +170,7 @@ def main():
                        CARGO_INCREMENTAL="0", CARGO_HOME=str(output / "cargo-home"),
                        # Installed rlibs must support consumers using fat/thin
                        # LTO as well as ordinary native-object linking.
-                       CARGO_ENCODED_RUSTFLAGS="-C\x1fembed-bitcode=yes")
+                       CARGO_ENCODED_RUSTFLAGS="\x1f".join(std_rustflags(output, sources)))
     cfg = run([str(wrapper), "-Zunstable-options", "--print", "cfg", "--target",
                str(target)], env=environment)
     (output / "target-cfg.txt").write_text(cfg)
@@ -212,7 +224,7 @@ def main():
         shutil.copy2(library, target_library / library.name)
     archive = output / "std-probe.a"
     shutil.copyfile(archives[0], archive)
-    result = {"source_manifest_sha256": digest(HERE / "source-files.json"), "native_inputs": frozen_native, "profile": profile, "official_compiler": str(compiler), "official_cargo": cargo, "build_jobs": args.jobs, "probe": args.probe, "probe_sha256": digest(probe_source),
+    result = {"source_manifest_sha256": digest(HERE / "source-files.json"), "native_inputs": frozen_native, "profile": profile, "official_compiler": str(compiler), "official_cargo": cargo, "build_jobs": args.jobs, "std_rustflags": std_rustflags(output, sources), "probe": args.probe, "probe_sha256": digest(probe_source),
               "precompiled_std": {p.name: digest(p) for p in std_rlibs},
               "compiler_commit": COMMIT, "compiler_sha256": compiler_sha256,
               "target_sha256": digest(target), "std_patch_sha256": digest(HERE / "rust-src-aros.diff"),
diff --git a/tools/crosstools/rust/unmodified/test-source-paths.py b/tools/crosstools/rust/unmodified/test-source-paths.py
new file mode 100644
index 00000000..a64d7ca8
--- /dev/null
+++ b/tools/crosstools/rust/unmodified/test-source-paths.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Check that std flags remove build paths from embedded Rust file! text."""
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.dont_write_bytecode = True
+here = Path(__file__).resolve().parent
+sys.path.insert(0, str(here))
+spec = importlib.util.spec_from_file_location("std_builder", here / "build.py")
+builder = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(builder)
+with tempfile.TemporaryDirectory(prefix="aros-std-path-test-") as directory:
+    output = Path(directory)
+    sources = output / "sysroot/lib/rustlib/src/rust"
+    sources.mkdir(parents=True)
+    source = sources / "diagnostic.rs"
+    source.write_text('#[unsafe(no_mangle)] pub fn diagnostic_path() -> &\'static str { file!() }\n')
+    target = output / "probe.ll"
+    flags = builder.std_rustflags(output, sources)
+    subprocess.run([os.environ["TEST_RUSTC"], "--crate-type=lib", "--emit=llvm-ir", *flags,
+                    str(source), "-o", str(target)], check=True)
+    result = target.read_text()
+    assert str(output) not in result, "workstation path remains in generated IR"
+    assert "/rust-src/diagnostic.rs" in result, "diagnostic provenance lost"
+print("PASS embedded source-path remapping with actual rustc")
