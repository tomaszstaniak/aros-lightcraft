--- a/crates/scenes/src/lib.rs
+++ b/crates/scenes/src/lib.rs
@@ -15,6 +15,9 @@ use serde::Serialize;
 
 pub use paint::render_srgb_linear;
 
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RenderCancelled;
+
 /// Kinds of scene the generator knows.
 #[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
 #[serde(rename_all = "camelCase")]
@@ -80,6 +83,12 @@ impl Scene {
         paint::render_serial(self.kind, self.seed, w, h)
     }
 
+    /// Check cancellation before allocation and each row; partial pixels are never returned.
+    pub fn render_fit_cancellable(&self, max_edge: usize, parallel: bool, cancelled: &(impl Fn() -> bool + Sync)) -> Result<Rgb32f, RenderCancelled> {
+        let (w, h) = self.fit(max_edge);
+        paint::render_cancellable(self.kind, self.seed, w, h, parallel, cancelled)
+    }
+
     fn fit(&self, max_edge: usize) -> (usize, usize) {
         // never past the scene's own size: that is a demo photo's full resolution, and a size
         // from a damaged catalog (a width of 4294967295) asked for more memory than exists
@@ -252,3 +261,28 @@ mod tests {
         assert!(err < 0.08, "{err}");
     }
 }
+
+#[cfg(test)]
+mod cancel_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    #[test]
+    fn cancelled_generation_returns_error_instead_of_partial_pixels() {
+        let scene = demo_library().remove(0);
+        for parallel in [false, true] {
+            let rows = AtomicUsize::new(0);
+            let result = scene.render_fit_cancellable(32, parallel, &|| rows.fetch_add(1, Ordering::Relaxed) >= 3);
+            assert!(result.is_err());
+            assert!(rows.load(Ordering::Relaxed) >= 4);
+        }
+    }
+    #[test]
+    fn uncancelled_generation_preserves_upstream_pixels() {
+        let scene = demo_library().remove(0);
+        let expected = scene.render_fit(32);
+        for parallel in [false, true] {
+            let result = scene.render_fit_cancellable(32, parallel, &|| false);
+            assert!(matches!(result, Ok(ref image) if image.data == expected.data));
+        }
+    }
+}
diff --git a/crates/scenes/src/paint.rs b/crates/scenes/src/paint.rs
index 4f3c4560be017abf04410367f956722c65dc6e2e..a89546762d5140b3be4f15e686206fab75448912 100644
