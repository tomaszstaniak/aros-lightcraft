From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LightCraft AROS port <lightcraft-aros@invalid>
Date: Sat, 24 Oct 2026 03:38:43 +0200
Subject: [PATCH] Cancel AROS procedural generations between rows without
 publishing partial pixels

---
 crates/engine/src/demo.rs  | 51 +++++++++++++++++++++++++++++++++++---
 crates/scenes/src/lib.rs   | 34 +++++++++++++++++++++++++
 crates/scenes/src/paint.rs | 24 ++++++++++++++----
 3 files changed, 101 insertions(+), 8 deletions(-)

diff --git a/crates/engine/src/demo.rs b/crates/engine/src/demo.rs
index 797d7520303e6c0ab257413fff5293cc76b18af8..8c7b5375d49004f948a0aa458758fe2bfdb62402 100644
--- a/crates/engine/src/demo.rs
+++ b/crates/engine/src/demo.rs
@@ -137,10 +137,22 @@ pub(crate) fn scene_pixels(scene: &lightcraft_scenes::Scene, max_edge: usize) ->
             }
         }
     };
+    #[cfg(not(target_os = "aros"))]
     let pixels = slot.get_or_generate(|how| match how {
         Render::Parallel => scene.render_fit(max_edge),
         Render::Serial => scene.render_fit_serial(max_edge),
     });
+    #[cfg(target_os = "aros")]
+    let pixels = slot.get_or_generate_checked(|how| {
+        if max_edge >= scene.width.max(scene.height) as usize {
+            log::info!("demo full-resolution generation started: {}x{}", scene.width, scene.height);
+        }
+        scene.render_fit_cancellable(max_edge, matches!(how, Render::Parallel), &lightcraft_workers::closing)
+            .map_err(|_| {
+                log::info!("demo generation cancelled during shutdown");
+                "demo generation cancelled during shutdown".to_string()
+            })
+    });
     trim_scene_cache(&mut scene_cache(), scene_cache_limit());
     pixels
 }
@@ -164,7 +176,7 @@ const FAILED: &str = "the demo scene could not be generated";
 /// scan's pace, `LIGHTCRAFT_FACE_THREADS`). Any other caller (the render workers, which are plain
 /// threads) renders in parallel on [`render_pool`], whose threads only ever render, and blocks
 /// without running other work meanwhile; where that pool can't be started it renders alone too.
-fn generate(render: impl FnOnce(Render) -> lightcraft_raster::Rgb32f + Send) -> lightcraft_raster::Rgb32f {
+fn generate<T: Send>(render: impl FnOnce(Render) -> T + Send) -> T {
     if rayon::current_thread_index().is_some() {
         return render(Render::Serial);
     }
@@ -257,7 +269,12 @@ impl SceneSlot {
     /// The pixels `render` makes ([`generate`]), generated once: the first caller renders, with no
     /// lock held, and later ones wait for its outcome. A render that panics is an error for the
     /// callers of its generation, and the next request tries again.
+    #[cfg(any(not(target_os = "aros"), test))]
     fn get_or_generate(&self, render: impl FnOnce(Render) -> lightcraft_raster::Rgb32f + Send) -> Result<Arc<lightcraft_raster::Rgb32f>, String> {
+        self.get_or_generate_checked(|how| Ok(render(how)))
+    }
+
+    fn get_or_generate_checked(&self, render: impl FnOnce(Render) -> Result<lightcraft_raster::Rgb32f, String> + Send) -> Result<Arc<lightcraft_raster::Rgb32f>, String> {
         let mut g = self.lock();
         let n = match &g.generation {
             Generation::Ready(p) => return Ok(p.clone()),
@@ -279,8 +296,8 @@ impl SceneSlot {
         let made = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| generate(render)));
         let mut g = self.lock();
         g.generation = match made {
-            Ok(pixels) => Generation::Ready(Arc::new(pixels)),
-            Err(_) => Generation::Failed,
+            Ok(Ok(pixels)) => Generation::Ready(Arc::new(pixels)),
+            Ok(Err(_)) | Err(_) => Generation::Failed,
         };
         let outcome = g.outcome(n).unwrap_or_else(|| Err(FAILED.into()));
         drop(g);
@@ -344,6 +361,34 @@ fn trim_scene_cache(c: &mut SceneCache, limit: usize) {
 mod tests {
     use super::*;
 
+    #[test]
+    fn cancelled_result_wakes_waiters_and_is_not_cached() {
+        within(5, || {
+            let slot = std::sync::Arc::new(SceneSlot::default());
+            let (started_tx, started_rx) = std::sync::mpsc::channel();
+            let (finish_tx, finish_rx) = std::sync::mpsc::channel();
+            let generator = {
+                let slot = slot.clone();
+                std::thread::spawn(move || slot.get_or_generate_checked(move |_| {
+                    started_tx.send(()).unwrap();
+                    finish_rx.recv().unwrap();
+                    Err("cancelled".into())
+                }))
+            };
+            started_rx.recv().unwrap();
+            let waiter = {
+                let slot = slot.clone();
+                std::thread::spawn(move || slot.get_or_generate_checked(|_| Ok(pixels(9))))
+            };
+            until_waiting(&slot, 1);
+            finish_tx.send(()).unwrap();
+            assert!(generator.join().unwrap().is_err());
+            assert!(waiter.join().unwrap().is_err());
+            assert!(slot.ready().is_none());
+            assert!(slot.get_or_generate_checked(|_| Ok(pixels(3))).is_ok());
+        });
+    }
+
     fn small_scene() -> lightcraft_scenes::Scene {
         lightcraft_scenes::demo_library().swap_remove(0)
     }
