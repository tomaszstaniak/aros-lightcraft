 }
 
 fn render_rows(kind: Kind, seed: u32, w: usize, h: usize, parallel: bool) -> Rgb32f {
+    match render_rows_checked(kind, seed, w, h, parallel, &|| Ok::<(), std::convert::Infallible>(())) {
+        Ok(image) => image,
+        Err(never) => match never {},
+    }
+}
+
+pub(crate) fn render_cancellable(kind: Kind, seed: u32, w: usize, h: usize, parallel: bool, cancelled: &(impl Fn() -> bool + Sync)) -> Result<Rgb32f, crate::RenderCancelled> {
+    render_rows_checked(kind, seed, w, h, parallel, &|| if cancelled() { Err(crate::RenderCancelled) } else { Ok(()) })
+}
+
+fn render_rows_checked<E: Send>(kind: Kind, seed: u32, w: usize, h: usize, parallel: bool, check: &(impl Fn() -> Result<(), E> + Sync)) -> Result<Rgb32f, E> {
+    check()?;
     let mut img = Rgb32f::new(w, h);
     if w == 0 || h == 0 {
-        return img;
+        return Ok(img);
     }
     let aspect = w as f32 / h as f32;
     let p = P { seed, aspect };
     let ss = if w * h <= 300_000 { 2 } else { 1 };
     let to2020 = SRGB.to_space(&REC2020).to_f32();
-    let paint = |(y, row): (usize, &mut [[f32; 3]])| {
+    let paint = |(y, row): (usize, &mut [[f32; 3]])| -> Result<(), E> {
+        check()?;
         for (xi, px) in row.iter_mut().enumerate() {
             let mut acc = [0.0f32; 3];
             for sy in 0..ss {
@@ -233,13 +246,14 @@ fn render_rows(kind: Kind, seed: u32, w: usize, h: usize, parallel: bool) -> Rgb
                 (m[2][0] * c[0] + m[2][1] * c[1] + m[2][2] * c[2]).max(0.0),
             ];
         }
+        Ok(())
     };
     if parallel {
-        img.data.par_chunks_mut(w).enumerate().for_each(paint);
+        img.data.par_chunks_mut(w).enumerate().try_for_each(paint)?;
     } else {
-        img.data.chunks_mut(w).enumerate().for_each(paint);
+        img.data.chunks_mut(w).enumerate().try_for_each(paint)?;
     }
-    img
+    Ok(img)
 }
 
