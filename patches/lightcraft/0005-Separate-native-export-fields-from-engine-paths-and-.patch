From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LightCraft AROS port <lightcraft-aros@invalid>
Date: Sat, 24 Oct 2026 03:06:41 +0200
Subject: [PATCH] Separate native export fields from engine paths and ignore
 unused folders

---
 crates/aros-platform/src/lib.rs      | 19 ++++++++++++++++++-
 crates/ui-egui/src/control.rs        |  9 +++++----
 crates/ui-egui/src/menus.rs          |  2 ++
 crates/ui-egui/src/panels/dialogs.rs | 14 +++++++++++++-
 4 files changed, 38 insertions(+), 6 deletions(-)

diff --git a/crates/aros-platform/src/lib.rs b/crates/aros-platform/src/lib.rs
index 14bbf44d321111ffd6cb153005174031e08153a4..3e1b34fa2c5cf88fb127bdf0f50a1d2b92da5772 100644
--- a/crates/aros-platform/src/lib.rs
+++ b/crates/aros-platform/src/lib.rs
@@ -164,7 +164,8 @@ impl Drop for FileLock {
 }
 
 /// Export controls already carry -nix paths from pickers/protocol requests. Resolve
-/// human-entered DOS/relative paths before upstream PathBuf joins a new leaf.
+/// protocol DOS/relative paths before upstream PathBuf joins a new leaf. Human
+/// dialog input must use absolute() directly: its leading / means DOS parent.
 pub fn engine_path(name: &str) -> Result<String, String> {
     if name.is_empty() || name.starts_with('/') && !name.contains(':') {
         return Ok(name.to_owned());
@@ -180,3 +181,19 @@ mod engine_path_tests {
         }
     }
 }
+
+/// Display an engine export destination in a human AmigaDOS field. The dialog
+/// resolves it with DOS again on submit; / is therefore never guessed from text.
+pub fn export_field(name: &str) -> Result<String, String> {
+    if name.starts_with('/') && !name.contains(':') { nix_to_dos(name) } else { Ok(name.to_owned()) }
+}
+#[cfg(test)]
+mod export_field_tests {
+    #[test]
+    fn engine_paths_become_native_fields() {
+        assert_eq!(super::export_field("/RAM Disk").unwrap(), "RAM Disk:");
+        assert_eq!(super::export_field("/Work/My Photos").unwrap(), "Work:My Photos");
+        assert_eq!(super::export_field("RAM:").unwrap(), "RAM:");
+        assert_eq!(super::export_field("").unwrap(), "");
+    }
+}
diff --git a/crates/ui-egui/src/control.rs b/crates/ui-egui/src/control.rs
index dd26ba2ce420585d314878b125afa7b1cd3d6b76..32bf56983c22b39af7665c5b60e53a6cd9cbff24 100644
--- a/crates/ui-egui/src/control.rs
+++ b/crates/ui-egui/src/control.rs
@@ -535,10 +535,11 @@ pub fn export_active(app: &mut LightcraftApp, p: &Value) -> Result<Value, String
     // may instead be AmigaDOS (RAM:, an assign, or a relative drawer). Resolve it
     // before the engine joins a generated file name, especially at volume roots.
     #[cfg(target_os = "aros")]
-    let (dir, exact) = (
-        lightcraft_aros_platform::engine_path(&dir)?,
-        exact.map(|p| lightcraft_aros_platform::engine_path(&p)).transpose()?,
-    );
+    let (dir, exact) = {
+        let dir = if exact.is_none() && !own_folders { lightcraft_aros_platform::engine_path(&dir)? } else { dir };
+        let exact = exact.map(|p| lightcraft_aros_platform::engine_path(&p)).transpose()?;
+        (dir, exact)
+    };
     let to = Destination { dir: dir.clone(), exact };
     // Add to Apple Photos: refused here, before anything is written, when it can't be done
     let after = app.session.after_export(&opts)?;
diff --git a/crates/ui-egui/src/menus.rs b/crates/ui-egui/src/menus.rs
index 04d43e0d34ff3d9c91c9e0d2bf3607ce8a92faa9..6bda2a2e816251756f6c5379d70c57e870afcd5b 100644
--- a/crates/ui-egui/src/menus.rs
+++ b/crates/ui-egui/src/menus.rs
@@ -1489,6 +1489,8 @@ pub fn run_ui_command(app: &mut LightcraftApp, id: &str, p: &Value) -> Option<Re
             let prev = app.session.last_export.clone().unwrap_or_default();
             let u = |k: &str, d: u64| prev.get(k).and_then(Value::as_u64).unwrap_or(d);
             let dir = prev.get("dir").and_then(Value::as_str).map(str::to_string).unwrap_or_else(crate::control::default_export_dir);
+            #[cfg(target_os = "aros")]
+            let dir = lightcraft_aros_platform::export_field(&dir)?;
             // stored settings: a depth the format lacks (saved before #1952) opens at the format's own
             let opts = lightcraft_engine::export::ExportOptions::from_json(&lightcraft_engine::export::ExportOptions::known_keys_only(&prev));
             // no previous export: 2048 px long edge; a previous full-size export: full size
diff --git a/crates/ui-egui/src/panels/dialogs.rs b/crates/ui-egui/src/panels/dialogs.rs
index b8c448ca2daf341986a82a959af839d26a98d2f1..005c54053fb5c86bfb88094d4ee9107f3fb8ced2 100644
--- a/crates/ui-egui/src/panels/dialogs.rs
+++ b/crates/ui-egui/src/panels/dialogs.rs
@@ -1027,7 +1027,13 @@ pub fn show(app: &mut LightcraftApp, ctx: &egui::Context) {
                                     && let Some(pick) = app.services.pick_folder.as_mut()
                                     && let Some(d) = pick()
                                 {
-                                    *dir = d;
+                                    #[cfg(target_os = "aros")]
+                                    match lightcraft_aros_platform::export_field(&d) {
+                                        Ok(d) => *dir = d,
+                                        Err(e) => app.toast(ui.ctx(), e),
+                                    }
+                                    #[cfg(not(target_os = "aros"))]
+                                    { *dir = d; }
                                 }
                                 crate::widgets::named(ui.add(egui::TextEdit::singleline(dir).desired_width(ui.available_width())), crate::i18n::tr("Folder"));
                             });
@@ -1911,6 +1917,12 @@ pub fn confirm_dialog(app: &mut LightcraftApp, dlg: &Dialog) -> Result<serde_jso
         Dialog::PasteSettings { groups } => app.run("develop.paste", json!({"groups": groups})),
         Dialog::Export { opts, full_size, resize, limit_kb, dir, .. } => {
             let mut p = export_dialog_params(opts, *full_size, resize, *limit_kb);
+            // This is human input, always AmigaDOS on AROS (including parent /).
+            // Requester/previous engine paths are displayed as DOS before editing.
+            #[cfg(target_os = "aros")]
+            let dir = if opts.destination_mode == lightcraft_engine::export::DestinationMode::SpecificFolder && !dir.trim().is_empty() {
+                lightcraft_aros_platform::absolute(dir)?.into_os_string().into_string().map_err(|_| "export folder is not UTF-8")?
+            } else { String::new() };
             p["dir"] = json!(dir);
             p["background"] = json!(true);
             app.run("app.export", p)
