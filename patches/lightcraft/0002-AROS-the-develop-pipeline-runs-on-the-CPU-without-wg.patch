index 711bebb102f5297bbc965f479db74de7cf79791a..a788cc34cee7bee8e87572615a37d094dddc85d3 100644
--- a/crates/engine/src/cmd/face_detect.rs
+++ b/crates/engine/src/cmd/face_detect.rs
@@ -143,7 +143,12 @@ pub(crate) fn offer_gpu(
     set_gpu_state(what, GpuState { checking: true, ..GpuState::default() });
     let spawned = std::thread::Builder::new().name(format!("faces-gpu-{what}")).spawn(move || {
         let _task = task;
-        let gpu = match lightcraft_gpu::faces::accelerator() {
+        // AROS: no GPU compute (lightcraft-gpu has no wgpu backend there); the models stay on the CPU.
+        #[cfg(target_os = "aros")]
+        let accelerator: std::result::Result<Arc<dyn lightcraft_faces::net::Accelerator>, String> = Err("there is no GPU compute on AROS".into());
+        #[cfg(not(target_os = "aros"))]
+        let accelerator = lightcraft_gpu::faces::accelerator();
+        let gpu = match accelerator {
             Ok(gpu) => gpu,
             Err(why) => {
                 log::info!("faces: {what} runs on the CPU ({why})");
