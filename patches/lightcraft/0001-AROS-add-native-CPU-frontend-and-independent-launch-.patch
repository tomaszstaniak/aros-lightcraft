+use std::{env, path::PathBuf, process::Command};
+fn main() {
+    println!("cargo:rerun-if-changed=c/platform.c");
+    for key in ["AROS_GCC", "AROS_AR", "AROS_SDK"] {
+        println!("cargo:rerun-if-env-changed={key}");
+    }
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("aros") {
+        return;
+    }
+    let out = PathBuf::from(env::var_os("OUT_DIR").expect("Cargo OUT_DIR"));
+    let cc = env::var_os("AROS_GCC").expect("set AROS_GCC");
+    let sdk = env::var("AROS_SDK").expect("set AROS_SDK");
+    let obj = out.join("platform.o");
+    assert!(
+        Command::new(cc)
+            .args([format!("--sysroot={sdk}"), "-O2".into(), "-Wall".into(), "-Werror".into(), "-c".into(), "c/platform.c".into(), "-o".into()])
+            .arg(&obj)
+            .status()
+            .expect("run AROS compiler")
+            .success()
+    );
+    let archive = out.join("liblightcraft_platform.a");
+    let _ = std::fs::remove_file(&archive);
+    assert!(
+        Command::new(env::var_os("AROS_AR").expect("set AROS_AR")).arg("rcs").arg(archive).arg(obj).status().expect("run AROS archiver").success()
+    );
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=lightcraft_platform");
+    println!("cargo:rustc-link-lib=icon");
+    println!("cargo:rustc-link-lib=intuition");
+}
