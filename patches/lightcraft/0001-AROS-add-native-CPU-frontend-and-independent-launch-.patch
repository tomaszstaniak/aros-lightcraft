+//! LightCraft AROS host: upstream app/services, shared egui-aros CPU window and input.
+#![forbid(unsafe_code)]
+#[cfg(target_os = "aros")]
+mod native;
+fn main() -> std::process::ExitCode {
+    #[cfg(target_os = "aros")]
+    return native::main();
+    #[cfg(not(target_os = "aros"))]
+    {
+        eprintln!("LightCraft AROS requires x86_64 AROS ABIv11");
+        std::process::ExitCode::FAILURE
+    }
+}
diff --git a/apps/lightcraft-aros/src/native.rs b/apps/lightcraft-aros/src/native.rs
new file mode 100644
index 0000000000000000000000000000000000000000..abc8aefe8d84b684916553bcbd9690bebfd1e5c1
--- /dev/null
+++ b/apps/lightcraft-aros/src/native.rs
@@ -0,0 +1,385 @@
+use lightcraft_aros_platform as platform;
+use lightcraft_launch_config::{Capabilities, Request};
+use lightcraft_ui_egui::{LightcraftApp, Services};
+use serde_json::{Value, json};
+use std::{
+    cell::RefCell,
+    collections::VecDeque,
+    io::Write,
+    path::PathBuf,
+    rc::Rc,
+    sync::{Mutex, mpsc},
+    time::{Duration, Instant},
+};
+
+struct Logger;
+static LOGGER: Logger = Logger;
+static LOG: std::sync::OnceLock<Option<Mutex<std::fs::File>>> = std::sync::OnceLock::new();
+fn line(text: &str) {
+    eprintln!("{text}");
+    if let Some(file) = LOG.get_or_init(|| {
+        let path = std::env::var("LIGHTCRAFT_LOG_FILE").unwrap_or_else(|_| "PROGDIR:LightCraft.log".into());
+        std::fs::OpenOptions::new().create(true).append(true).open(path).ok().map(Mutex::new)
+    }) {
+        let mut f = file.lock().unwrap_or_else(|p| p.into_inner());
+        let _ = writeln!(f, "{text}");
+        let _ = f.flush();
+    }
+}
+impl log::Log for Logger {
+    fn enabled(&self, m: &log::Metadata) -> bool {
+        m.level() <= log::Level::Info
+    }
+    fn log(&self, r: &log::Record) {
+        if self.enabled(r.metadata()) {
+            line(&format!("{} {}: {}", r.level(), r.target(), r.args()));
+        }
+    }
+    fn flush(&self) {}
+}
+fn error(message: &str, workbench: bool) {
+    line(&format!("ERROR: {message}"));
+    if workbench {
+        platform::show_error(message);
+    }
+}
+fn normalized(name: &str) -> Result<String, String> {
+    platform::absolute(name)?.into_os_string().into_string().map_err(|_| "path is not UTF-8".into())
+}
+
+struct Options {
+    files: Vec<String>,
+    library: Option<String>,
+    script: Option<String>,
+    report: Option<String>,
+    screenshot: Option<String>,
+    frames: Option<u64>,
+    demo: bool,
+}
+fn options(args: Vec<String>, files: Vec<String>) -> Result<Options, String> {
+    let mut o = Options { files, library: None, script: None, report: None, screenshot: None, frames: None, demo: false };
+    let mut a = args.into_iter();
+    while let Some(arg) = a.next() {
+        match arg.as_str() {
+            "--demo" => o.demo = true,
+            "--library" | "--script" | "--report" | "--screenshot" => {
+                let path = normalized(&a.next().ok_or_else(|| format!("{arg}: missing path"))?)?;
+                match arg.as_str() {
+                    "--library" => o.library = Some(path),
+                    "--script" => o.script = Some(path),
+                    "--report" => o.report = Some(path),
+                    _ => o.screenshot = Some(path),
+                }
+            }
+            "--frames" => {
+                let s = a.next().ok_or("--frames: missing count")?;
+                o.frames = Some(s.parse().map_err(|_| "--frames: invalid count")?);
+            }
+            "--" => {
+                for p in a {
+                    o.files.push(normalized(&p)?);
+                }
+                break;
+            }
+            _ if arg.starts_with('-') => return Err(format!("unknown option `{arg}`; see --help")),
+            _ => o.files.push(normalized(&arg)?),
+        }
+    }
+    Ok(o)
+}
+
+pub fn main() -> std::process::ExitCode {
+    // Exact -nix link mode: main owns the CRT directory restore before any worker can chdir.
+    if let Err(e) = std::env::set_current_dir(".") {
+        error(&format!("cannot preserve startup directory: {e}"), true);
+        return std::process::ExitCode::from(20);
+    }
+    if log::set_logger(&LOGGER).is_ok() {
+        log::set_max_level(log::LevelFilter::Info);
+    }
+    std::panic::set_hook(Box::new(|p| line(&format!("PANIC: {p}"))));
+    let startup = match platform::startup() {
+        Ok(s) => s,
+        Err(e) => {
+            error(&e, true);
+            return std::process::ExitCode::from(2);
+        }
+    };
+    let args: Vec<String> = if startup.workbench { Vec::new() } else { std::env::args().skip(1).collect() };
+    if args.iter().any(|a| a == "--help" || a == "-h") {
+        println!(
+            "LightCraft 0.13.0 AROS x86_64 ABIv11\nUsage: LightCraft [OPTIONS] [FILES...]\n  --library DRAWER   persistent catalog (default: PROGDIR:LightCraftData/Library)\n  --demo             procedural demo library\n  --script FILE      sequential JSON-lines control requests\n  --report FILE      script replies (JSON lines)\n  --frames N         close after N frames (diagnostics)\n  --screenshot FILE  capture final CPU window frame\n{}",
+            lightcraft_launch_config::HELP
+        );
+        return std::process::ExitCode::SUCCESS;
+    }
+    if args.iter().any(|a| a == "--version") {
+        println!("LightCraft 0.13.0 AROS x86_64 ABIv11");
+        return std::process::ExitCode::SUCCESS;
+    }
+    let (request, args) = match Request::parse(&args, &startup.tooltypes) {
+        Ok(v) => v,
+        Err(e) => {
+            error(&e, startup.workbench);
+            return std::process::ExitCode::from(2);
+        }
+    };
+    line(&format!(
+        "launch: workbench={} GUI_RENDERER requested={} IMAGE_COMPUTE requested={}",
+        startup.workbench,
+        request.gui.name(),
+        request.image.name()
+    ));
+    for key in ["LIGHTCRAFT_GPU", "LIGHTCRAFT_GPU_BACKEND", "WGPU_BACKEND"] {
+        if let Ok(v) = std::env::var(key) {
+            line(&format!("legacy environment {key}={v}; cannot override the launch CPU policy"));
+        }
+    }
+    let modes = match request.resolve(Capabilities { gui_gpu: false, image_gpu: false }) {
+        Ok(m) => m,
+        Err(e) => {
+            line(&format!(
+                "GUI_RENDERER: requested={} actual=NOT_STARTED; IMAGE_COMPUTE: requested={} actual=NOT_STARTED; startup aborted: {e}",
+                request.gui.name(),
+                request.image.name()
+            ));
+            error(&e, startup.workbench);
+            return std::process::ExitCode::from(2);
+        }
+    };
+    for (name, mode) in [("GUI_RENDERER", modes.gui), ("IMAGE_COMPUTE", modes.image)] {
+        line(&format!(
+            "{name}: requested={} actual={}{}",
+            mode.requested.name(),
+            mode.actual.name(),
+            mode.reason.map(|r| format!("; {r}")).unwrap_or_default()
+        ));
+    }
+    lightcraft_engine::gpu::require_cpu();
+    let opts = match options(args, startup.files) {
+        Ok(o) => o,
+        Err(e) => {
+            error(&e, startup.workbench);
+            return std::process::ExitCode::from(2);
+        }
+    };
+    let result = run(opts);
+    // All app/session scopes have dropped before ending the global pool.
+    rayon_core::terminate_global_thread_pool();
+    match result {
+        Ok(()) => {
+            line("shutdown: complete");
+            std::process::ExitCode::SUCCESS
+        }
+        Err(e) => {
+            error(&e, startup.workbench);
+            std::process::ExitCode::FAILURE
+        }
+    }
+}
+
+type SharedWindow = Rc<RefCell<Option<egui_aros::WindowHandle>>>;
+fn services(window: SharedWindow, drawer: Rc<RefCell<String>>) -> Services {
+    let pick_window = window.clone();
+    let pick_dir = drawer.clone();
+    Services {
+        picker: Some(Box::new(move |req| {
+            use lightcraft_ui_egui::pick::PickKind;
+            let window = pick_window.borrow().clone().ok_or("window is not open")?;
+            let kind = match req.kind {
+                PickKind::Files => egui_aros::asl::Select::OpenMany,
+                PickKind::File => egui_aros::asl::Select::Open,
+                PickKind::Folder => egui_aros::asl::Select::Drawer,
+                PickKind::Save => egui_aros::asl::Select::Save,
+            };
+            let paths = egui_aros::asl::request(
+                &window,
+                kind,
+                req.title.as_deref().unwrap_or("LightCraft"),
+                &pick_dir.borrow(),
+                req.file_name.as_deref().unwrap_or(""),
+                "",
+            );
+            let paths = paths.into_iter().map(|p| normalized(&p)).collect::<Result<Vec<_>, _>>()?;
+            let (tx, rx) = mpsc::channel();
+            let _ = tx.send(paths);
+            Ok(rx)
+        })),
+        write: Some(Box::new(|p, b| std::fs::write(p, b).map_err(|e| format!("{p}: {e}")))),
+        write_shared: Some(std::sync::Arc::new(|p, b| std::fs::write(p, b).map_err(|e| format!("{p}: {e}")))),
+        png: Some(Box::new(|img| {
+            lightcraft_codecs::encode_png(&lightcraft_codecs::EncodeImage::rgba8(img), &Default::default()).unwrap_or_default()
+        })),
+        open_url: Some(Box::new(|u| if egui_aros::open_url(u) { Ok(()) } else { Err("OpenURL failed".into()) })),
+        log_file: Some("PROGDIR:LightCraft.log".into()),
+        ..Services::default()
+    }
+}
+struct Host {
+    app: LightcraftApp,
+    window: SharedWindow,
+    drawer: Rc<RefCell<String>>,
+    start: Instant,
+    frames: Option<u64>,
+    screenshot: Option<String>,
+    captured: bool,
+    script: VecDeque<Value>,
+    sender: mpsc::Sender<lightcraft_ui_egui::ControlRequest>,
+    reply: Option<mpsc::Receiver<Value>>,
+    report: Option<std::fs::File>,
+    failed: bool,
+}
+impl egui_aros::App for Host {
+    fn started(&mut self, w: egui_aros::WindowHandle) {
+        *self.window.borrow_mut() = Some(w);
+    }
+    fn logic(&mut self, ctx: &egui::Context) {
+        self.app.ui.settings.gpu = false;
+        self.app.logic(ctx);
+        if let Some(id) = self.app.session.active() {
+            if let Some(photo) = self.app.session.catalog.photo(id) {
+                if let lightcraft_engine::catalog::Source::File { path, .. } = &photo.source {
+                    if let Some(parent) = std::path::Path::new(path).parent().and_then(|p| p.to_str()) {
+                        if let Ok(d) = platform::nix_to_dos(parent) {
+                            *self.drawer.borrow_mut() = d;
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(rx) = &self.reply {
+            if let Ok(v) = rx.try_recv() {
+                self.failed |= v.get("ok") == Some(&Value::Bool(false));
+                if let Some(f) = &mut self.report {
+                    let _ = writeln!(f, "{v}");
+                    let _ = f.flush();
+                }
+                line(&format!("control: {v}"));
+                self.reply = None;
+            }
+        }
+        if self.reply.is_none() {
+            if let Some(v) = self.script.pop_front() {
+                let method = v.get("method").and_then(Value::as_str).unwrap_or("command");
+                let params = v.get("params").cloned().unwrap_or_else(|| json!({}));
+                let (req, rx) = lightcraft_ui_egui::ControlRequest::new(method, params);
+                if self.sender.send(req).is_ok() {
+                    self.reply = Some(rx);
+                }
+            }
+        }
+        if self.frames.is_some() || self.reply.is_some() || !self.script.is_empty() {
+            ctx.request_repaint();
+        }
+    }
+    fn raw_input_hook(&mut self, r: &mut egui::RawInput) {
+        self.app.raw_input_hook(r);
+    }
+    fn ui(&mut self, ui: &mut egui::Ui) {
+        self.app.ui(ui);
+    }
+    fn close_requested(&mut self) -> bool {
+        lightcraft_ui_egui::panels::notices::may_close(&mut self.app)
+    }
+    fn quit_requested(&self) -> bool {
+        self.app.quit_confirmed || self.start.elapsed() > Duration::from_secs(180) && self.frames.is_some()
+    }
+    fn frame_done(&mut self, r: &egui_aros::FrameReport, pixels: &egui_aros::raster::Renderer) {
+        if self.frames.is_some_and(|n| r.frame >= n) && self.script.is_empty() && self.reply.is_none() {
+            if !self.captured {
+                if let Some(path) = &self.screenshot {
+                    let image = lightcraft_codecs::EncodeImage::new(r.width, r.height, 4, lightcraft_codecs::Samples::U8(&pixels.frame));
+                    let result = lightcraft_codecs::encode_png(&image, &Default::default())
+                        .map_err(|e| e.to_string())
+                        .and_then(|b| std::fs::write(path, b).map_err(|e| e.to_string()));
+                    if let Err(e) = result {
+                        line(&format!("screenshot: {e}"));
+                        self.failed = true;
+                    }
+                }
+                self.captured = true;
+            }
+            if lightcraft_ui_egui::panels::notices::may_close(&mut self.app) {
+                self.app.quit_confirmed = true;
+            }
+        }
+    }
+}
+fn run(opts: Options) -> Result<(), String> {
+    std::fs::create_dir_all("PROGDIR:LightCraftData").map_err(|e| format!("cannot create settings drawer: {e}"))?;
+    let prefs = PathBuf::from("PROGDIR:LightCraftData/ui.json");
+    let ui = if prefs.exists() {
+        Some(
+            serde_json::from_slice::<lightcraft_ui_egui::UiState>(&std::fs::read(&prefs).map_err(|e| e.to_string())?)
+                .map_err(|e| format!("saved settings: {e}; original preserved"))?,
+        )
+    } else {
+        None
+    };
+    let library = match opts.library {
+        Some(p) => p,
+        None => {
+            ui.as_ref().map(|u| u.settings.library_path.clone()).filter(|s| !s.is_empty()).unwrap_or(normalized("PROGDIR:LightCraftData/Library")?)
+        }
+    };
+    let mut session = lightcraft_engine::Session::new().with_fs().with_system_clock();
+    session.open_library(&library, opts.demo).map_err(|e| e.to_string())?;
+    let window = Rc::new(RefCell::new(None));
+    let drawer = Rc::new(RefCell::new(String::new()));
+    let (tx, rx) = mpsc::channel();
+    let mut app = LightcraftApp::new(session, services(window.clone(), drawer.clone())).with_control(rx);
+    if let Some(ui) = ui {
+        app.ui = ui;
+    }
+    app.ui.settings.gpu = false;
+    app.ui.settings.library_path = library;
+    if !opts.files.is_empty() {
+        lightcraft_ui_egui::import::start_paths(&mut app, opts.files)?;
+    }
+    let script = match opts.script {
+        Some(p) => std::fs::read_to_string(p)
+            .map_err(|e| e.to_string())?
+            .lines()
+            .filter(|s| !s.trim().is_empty())
+            .map(serde_json::from_str)
+            .collect::<Result<VecDeque<Value>, _>>()
+            .map_err(|e| e.to_string())?,
+        None => VecDeque::new(),
+    };
+    let report = opts.report.map(std::fs::File::create).transpose().map_err(|e| e.to_string())?;
+    let mut host = Host {
+        app,
+        window,
+        drawer,
+        start: Instant::now(),
+        frames: opts.frames,
+        screenshot: opts.screenshot,
+        captured: false,
+        script,
+        sender: tx,
+        reply: None,
+        report,
+        failed: false,
+    };
+    let size = egui_aros::screen_size().map(|(w, h)| (w.saturating_sub(30).min(1100), h.saturating_sub(70).min(720))).unwrap_or((1000, 650));
+    let result = egui_aros::run(
+        egui_aros::Options { title: "LightCraft".into(), inner_size: size, idle_poll: Some(Duration::from_millis(50)), ..Default::default() },
+        egui::Context::default(),
+        &mut host,
+    )
+    .map_err(|e| e.to_string());
+    let saved = serde_json::to_vec_pretty(&host.app.ui).map_err(|e| e.to_string()).and_then(|b| std::fs::write(&prefs, b).map_err(|e| e.to_string()));
+    let closed = host.app.session.close_library().map_err(|e| e.to_string());
+    let stopped = host.app.shutdown(Duration::from_secs(10));
+    line(&format!("shutdown: window closed; workers_stopped={stopped}"));
+    result?;
+    saved?;
+    closed?;
+    if !stopped {
+        return Err("background workers did not stop within ten seconds".into());
+    }
+    if host.failed {
+        return Err("one or more scripted operations failed (see report)".into());
+    }
+    Ok(())
+}
