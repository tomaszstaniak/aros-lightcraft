+//! Shared Shell/Workbench rendering configuration. No platform or GPU calls.
+#![forbid(unsafe_code)]
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Mode {
+    #[default]
+    Cpu,
+    Auto,
+    Gpu,
+}
+impl Mode {
+    pub fn parse(value: &str, key: &str) -> Result<Self, String> {
+        match value.trim().to_ascii_uppercase().as_str() {
+            "CPU" => Ok(Self::Cpu),
+            "AUTO" => Ok(Self::Auto),
+            "GPU" => Ok(Self::Gpu),
+            _ => Err(format!("{key}: unknown value `{value}`; expected CPU, AUTO or GPU")),
+        }
+    }
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Cpu => "CPU",
+            Self::Auto => "AUTO",
+            Self::Gpu => "GPU",
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Request {
+    pub gui: Mode,
+    pub image: Mode,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct Capabilities {
+    pub gui_gpu: bool,
+    pub image_gpu: bool,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Selection {
+    pub requested: Mode,
+    pub actual: Mode,
+    pub reason: Option<String>,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Resolved {
+    pub gui: Selection,
+    pub image: Selection,
+}
+impl Request {
+    /// CLI > Workbench tooltypes > CPU. Shell callers pass no tooltypes.
+    /// Only the selected value is parsed, so a stale icon cannot override CLI.
+    pub fn parse(args: &[String], tooltypes: &[String]) -> Result<(Self, Vec<String>), String> {
+        let mut gui = None;
+        let mut image = None;
+        let mut rest = Vec::new();
+        let mut iter = args.iter();
+        while let Some(arg) = iter.next() {
+            if arg == "--" {
+                rest.push(arg.clone());
+                rest.extend(iter.cloned());
+                break;
+            }
+            let (key, inline) = arg.split_once('=').map_or((arg.as_str(), None), |(k, v)| (k, Some(v)));
+            let slot = match key {
+                "--gui-renderer" => &mut gui,
+                "--image-compute" => &mut image,
+                _ => {
+                    rest.push(arg.clone());
+                    continue;
+                }
+            };
+            let value = inline.or_else(|| iter.next().map(String::as_str)).ok_or_else(|| format!("{key}: missing CPU, AUTO or GPU value"))?;
+            *slot = Some(Mode::parse(value, key)?);
+        }
+        for entry in tooltypes {
+            let Some((key, value)) = entry.split_once('=') else { continue };
+            match key.trim().to_ascii_uppercase().as_str() {
+                "GUI_RENDERER" if gui.is_none() => gui = Some(Mode::parse(value, "GUI_RENDERER")?),
+                "IMAGE_COMPUTE" if image.is_none() => image = Some(Mode::parse(value, "IMAGE_COMPUTE")?),
+                _ => {}
+            }
+        }
+        Ok((Self { gui: gui.unwrap_or_default(), image: image.unwrap_or_default() }, rest))
+    }
+    pub fn resolve(self, caps: Capabilities) -> Result<Resolved, String> {
+        fn select(requested: Mode, present: bool, path: &str) -> Result<Selection, String> {
+            let absent = format!("this build does not contain a GPU backend for {path}");
+            match requested {
+                Mode::Cpu => Ok(Selection { requested, actual: Mode::Cpu, reason: None }),
+                Mode::Auto if !present => Ok(Selection { requested, actual: Mode::Cpu, reason: Some(absent) }),
+                Mode::Gpu if !present => Err(format!("{path}=GPU: {absent}. Choose CPU or AUTO.")),
+                _ => Ok(Selection { requested, actual: Mode::Gpu, reason: None }),
+            }
+        }
+        Ok(Resolved { gui: select(self.gui, caps.gui_gpu, "GUI_RENDERER")?, image: select(self.image, caps.image_gpu, "IMAGE_COMPUTE")? })
+    }
+}
+
+pub const HELP: &str = "Rendering options (independent):\n  --gui-renderer CPU|AUTO|GPU\n  --image-compute CPU|AUTO|GPU\nCPU: no GPU initialization/probing (default). AUTO: try a supported GPU backend,\nelse CPU with a logged reason. GPU: require GPU, else a startup error.\nWorkbench ToolTypes: GUI_RENDERER=CPU, IMAGE_COMPUTE=CPU.\nPriority: explicit CLI > Workbench ToolType > CPU. Values are case-insensitive.\nThis AROS build is CPU-only for both paths.\nLegacy LIGHTCRAFT_GPU/LIGHTCRAFT_GPU_BACKEND/WGPU_BACKEND cannot enable GPU\nwhen CPU is selected; their values are recorded in the startup log.";
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn args(s: &[&str]) -> Vec<String> {
+        s.iter().map(|s| s.to_string()).collect()
+    }
+    #[test]
+    fn defaults_are_independent_cpu() {
+        let (r, rest) = Request::parse(&[], &[]).unwrap();
+        assert_eq!(r, Request { gui: Mode::Cpu, image: Mode::Cpu });
+        assert!(rest.is_empty());
+    }
+    #[test]
+    fn cli_overrides_workbench_with_mixed_case_and_keeps_files() {
+        let (r, rest) = Request::parse(
+            &args(&["--gui-renderer", "cPu", "--image-compute=AuTo", "RAM:My Photo.png"]),
+            &["GUI_RENDERER=GPU".into(), "IMAGE_COMPUTE=CPU".into()],
+        )
+        .unwrap();
+        assert_eq!(r, Request { gui: Mode::Cpu, image: Mode::Auto });
+        assert_eq!(rest, args(&["RAM:My Photo.png"]));
+    }
+    #[test]
+    fn workbench_values_use_same_parser() {
+        let (r, _) = Request::parse(&[], &args(&["gui_renderer=aUtO", "IMAGE_COMPUTE=gPu", "(GUI_RENDERER=GPU)"])).unwrap();
+        assert_eq!(r, Request { gui: Mode::Auto, image: Mode::Gpu });
+    }
+    #[test]
+    fn bad_values_and_missing_arguments_are_errors() {
+        for a in [args(&["--gui-renderer", "fast"]), args(&["--image-compute"]), args(&["--image-compute="])] {
+            assert!(Request::parse(&a, &[]).is_err());
+        }
+        assert!(Request::parse(&[], &args(&["GUI_RENDERER=bogus"])).is_err());
+    }
+    #[test]
+    fn cpu_only_auto_explains_and_gpu_refuses_each_path() {
+        let caps = Capabilities { gui_gpu: false, image_gpu: false };
+        let r = Request { gui: Mode::Auto, image: Mode::Cpu }.resolve(caps).unwrap();
+        assert_eq!(r.gui.actual, Mode::Cpu);
+        assert!(r.gui.reason.as_deref().unwrap().contains("build"));
+        assert!(r.image.reason.is_none());
+        for request in [Request { gui: Mode::Gpu, image: Mode::Cpu }, Request { gui: Mode::Cpu, image: Mode::Gpu }] {
+            assert!(request.resolve(caps).unwrap_err().contains("backend"));
+        }
+    }
+    #[test]
+    fn capabilities_are_separate() {
+        let caps = Capabilities { gui_gpu: true, image_gpu: false };
+        let r = Request { gui: Mode::Auto, image: Mode::Auto }.resolve(caps).unwrap();
+        assert_eq!(r.gui.actual, Mode::Gpu);
+        assert_eq!(r.image.actual, Mode::Cpu);
+    }
+    #[test]
+    fn dash_dash_keeps_document_names() {
+        let (_, rest) = Request::parse(&args(&["--", "--gui-renderer=GPU"]), &[]).unwrap();
+        assert_eq!(rest, args(&["--", "--gui-renderer=GPU"]));
+    }
+}
