+/// Convert path-bearing launch arguments before POSIX lexical code sees DOS names.
+#[cfg(target_os = "aros")]
+fn aros_paths(mut args: Vec<String>) -> Result<Vec<String>, String> {
+    let command = args.first().cloned().unwrap_or_default();
+    let mut path_next = false;
+    let mut skip_next = false;
+    let mut positional = 0;
+    for arg in args.iter_mut().skip(1) {
+        if path_next && arg == "-" {
+            path_next = false;
+        } else if path_next {
+            *arg = lightcraft_aros_platform::absolute(arg)?.to_str().ok_or("path is not UTF-8")?.to_string();
+            path_next = false;
+        } else if skip_next {
+            skip_next = false;
+        } else if matches!(arg.as_str(), "--library" | "--import" | "--script" | "--settings" | "--models" | "-o" | "--output") {
+            path_next = true;
+        } else if arg.starts_with('-') {
+            skip_next = matches!(
+                arg.as_str(),
+                "--set"
+                    | "--opt"
+                    | "--size"
+                    | "--quality"
+                    | "--preset"
+                    | "--scale"
+                    | "--max"
+                    | "--model"
+                    | "--listen"
+                    | "--token-env"
+                    | "--run-on"
+                    | "--max-connections"
+            );
+        } else if command == "render" && positional == 0 || matches!(command.as_str(), "snapshot" | "calibrate") {
+            *arg = lightcraft_aros_platform::absolute(arg)?.to_str().ok_or("path is not UTF-8")?.to_string();
+            positional += 1;
+        }
+    }
+    Ok(args)
+}
