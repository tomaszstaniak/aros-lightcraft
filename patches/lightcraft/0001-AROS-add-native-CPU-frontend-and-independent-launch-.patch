+//! AROS-only startup/path bridge. Unsafe code is isolated here, never in the engine/UI.
+#![allow(unsafe_code)]
+use std::path::PathBuf;
+#[cfg(target_os = "aros")]
+mod native {
+    use std::ffi::{CString, c_char};
+    unsafe extern "C" {
+        pub fn lc_workbench() -> i32;
+        pub fn lc_wb_file(index: i32, out: *mut c_char, cap: i32) -> i32;
+        pub fn lc_tooltype(key: *const c_char, out: *mut c_char, cap: i32) -> i32;
+        pub fn lc_absolute(name: *const c_char, out: *mut c_char, cap: i32) -> i32;
+        pub fn lc_file_lock(path: *const c_char) -> usize;
+        pub fn lc_file_unlock(lock: usize);
+        pub fn lc_dos_error() -> i32;
+        pub fn lc_error(message: *const c_char);
+    }
+    pub fn cstr(s: &str) -> Result<CString, String> {
+        CString::new(s).map_err(|_| "path/configuration contains NUL".into())
+    }
+    pub fn read(call: impl FnOnce(*mut c_char, i32) -> i32) -> Result<Option<String>, String> {
+        let mut bytes = vec![0u8; 8192];
+        let result = call(bytes.as_mut_ptr().cast(), bytes.len() as i32);
+        if result == 0 {
+            return Ok(None);
+        }
+        if result < 0 {
+            return Err("AROS could not resolve startup data or the path (missing drawer, unreadable icon, or path too long)".into());
+        }
+        let end = bytes.iter().position(|&b| b == 0).ok_or("unterminated DOS result")?;
+        bytes.truncate(end);
+        String::from_utf8(bytes).map(Some).map_err(|_| "DOS path is not UTF-8".into())
+    }
+}
+#[derive(Default, Debug)]
+pub struct Startup {
+    pub workbench: bool,
+    pub tooltypes: Vec<String>,
+    pub files: Vec<String>,
+}
+pub fn startup() -> Result<Startup, String> {
+    #[cfg(target_os = "aros")]
+    {
+        // SAFETY: read-only CRT global, while main still owns the startup lifetime.
+        if unsafe { native::lc_workbench() } == 0 {
+            return Ok(Startup::default());
+        }
+        let mut out = Startup { workbench: true, ..Startup::default() };
+        for key in ["GUI_RENDERER", "IMAGE_COMPUTE"] {
+            let c = native::cstr(key)?;
+            // SAFETY: valid strings and owned writable output, copied before DiskObject is freed.
+            if let Some(value) = native::read(|p, n| unsafe { native::lc_tooltype(c.as_ptr(), p, n) })? {
+                out.tooltypes.push(format!("{key}={value}"));
+            }
+        }
+        for i in 1..1024 {
+            // SAFETY: C checks index against the borrowed WBStartup argument array.
+            match native::read(|p, n| unsafe { native::lc_wb_file(i, p, n) })? {
+                Some(path) => out.files.push(dos_to_nix(&path)?),
+                None => return Ok(out),
+            }
+        }
+        Err("too many Workbench documents".into())
+    }
+    #[cfg(not(target_os = "aros"))]
+    Ok(Startup::default())
+}
+pub fn absolute(name: &str) -> Result<PathBuf, String> {
+    #[cfg(target_os = "aros")]
+    {
+        let c = native::cstr(name)?;
+        // SAFETY: input outlives call; DOS receives an owned writable buffer.
+        native::read(|p, n| unsafe { native::lc_absolute(c.as_ptr(), p, n) })?
+            .ok_or_else(|| "path was not resolved".to_string())
+            .and_then(|p| dos_to_nix(&p))
+            .map(PathBuf::from)
+    }
+    #[cfg(not(target_os = "aros"))]
+    std::path::absolute(name).map_err(|e| e.to_string())
+}
+pub fn show_error(message: &str) {
+    eprintln!("LightCraft: {message}");
+    #[cfg(target_os = "aros")]
+    if let Ok(c) = native::cstr(message) {
+        // SAFETY: NUL-terminated string, request completes before it is freed.
+        unsafe {
+            native::lc_error(c.as_ptr());
+        }
+    }
+}
+/// Convert a resolved DOS volume name to the selected -nix CRT path mode.
+/// No lexical parent collapsing: Lock/NameFromLock have already resolved it.
+pub fn dos_to_nix(path: &str) -> Result<String, String> {
+    let (volume, rest) = path.split_once(':').ok_or("DOS did not return a volume-qualified path")?;
+    if volume.is_empty() || volume.contains('/') {
+        return Err("invalid DOS volume name".into());
+    }
+    Ok(if rest.is_empty() { format!("/{volume}") } else { format!("/{volume}/{rest}") })
+}
+/// Only for already normalized engine paths passed back to an ASL requester.
+pub fn nix_to_dos(path: &str) -> Result<String, String> {
+    let rest = path.strip_prefix('/').ok_or("expected a normalized -nix absolute path")?;
+    let (volume, rest) = rest.split_once('/').unwrap_or((rest, ""));
+    if volume.is_empty() {
+        return Err("missing volume in -nix path".into());
+    }
+    Ok(format!("{volume}:{rest}"))
+}
+
+/// Drawer/name split follows AmigaDOS; a colon terminates a root drawer.
+pub fn split(path: &str) -> (&str, &str) {
+    match path.rfind(['/', ':']) {
+        Some(i) if path.as_bytes().get(i) == Some(&b':') => (&path[..=i], &path[i + 1..]),
+        Some(i) => (&path[..i], &path[i + 1..]),
+        None => ("", path),
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::{dos_to_nix, nix_to_dos, split};
+    #[test]
+    fn normalized_paths_round_trip() {
+        for p in ["RAM:", "Work:My Photos/zażółć.png", "Ram Disk:a.jpg"] {
+            assert_eq!(nix_to_dos(&dos_to_nix(p).unwrap()).unwrap(), p);
+        }
+        assert!(dos_to_nix(":bad").is_err());
+    }
+    #[test]
+    fn dos_drawers() {
+        assert_eq!(split("RAM:a.png"), ("RAM:", "a.png"));
+        assert_eq!(split("RAM:"), ("RAM:", ""));
+        assert_eq!(split("Work:My Photos/zażółć.png"), ("Work:My Photos", "zażółć.png"));
+        assert_eq!(split("a.png"), ("", "a.png"));
+    }
+}
+
+/// Exclusive DOS lock on an existing file, separate from POSIX try_lock (unsupported on v11).
+#[cfg(target_os = "aros")]
+#[derive(Debug)]
+pub struct FileLock(usize);
+#[cfg(target_os = "aros")]
+impl FileLock {
+    pub fn acquire(path: &std::path::Path) -> Result<Self, String> {
+        let dos = nix_to_dos(path.to_str().ok_or("lock path is not UTF-8")?)?;
+        let c = native::cstr(&dos)?;
+        // SAFETY: NUL-terminated owned name. A nonzero returned lock is owned by this guard.
+        let lock = unsafe { native::lc_file_lock(c.as_ptr()) };
+        if lock == 0 {
+            // SAFETY: reads main task's DOS error immediately after the failed Lock.
+            let code = unsafe { native::lc_dos_error() };
+            Err(format!("cannot exclusively lock {dos} (DOS error {code}); close any other LightCraft using this library"))
+        } else {
+            Ok(Self(lock))
+        }
+    }
+}
+#[cfg(target_os = "aros")]
+impl Drop for FileLock {
+    fn drop(&mut self) {
+        // SAFETY: exactly the nonzero lock acquired by this guard; never copied or released twice.
+        unsafe {
+            native::lc_file_unlock(self.0);
+        }
+    }
+}
