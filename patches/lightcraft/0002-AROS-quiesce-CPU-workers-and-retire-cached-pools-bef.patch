+//! Quiesce detached CPU producers before AROS joins threads and Rayon is terminated.
+#![forbid(unsafe_code)]
+use std::{
+    io,
+    sync::atomic::{AtomicBool, AtomicUsize, Ordering},
+    thread::{Builder, JoinHandle},
+    time::{Duration, Instant},
+};
+static ACTIVE: AtomicUsize = AtomicUsize::new(0);
+static CLOSING: AtomicBool = AtomicBool::new(false);
+struct Token;
+impl Drop for Token {
+    fn drop(&mut self) {
+        ACTIVE.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+pub trait BuilderExt {
+    fn spawn_tracked<F, T>(self, work: F) -> io::Result<JoinHandle<T>>
+    where
+        F: FnOnce() -> T + Send + 'static,
+        T: Send + 'static;
+}
+impl BuilderExt for Builder {
+    fn spawn_tracked<F, T>(self, work: F) -> io::Result<JoinHandle<T>>
+    where
+        F: FnOnce() -> T + Send + 'static,
+        T: Send + 'static,
+    {
+        if cfg!(any(target_os = "aros", test)) {
+            if closing() {
+                return Err(io::Error::other("LightCraft is closing; no new worker may start"));
+            }
+            ACTIVE.fetch_add(1, Ordering::AcqRel);
+            if closing() {
+                ACTIVE.fetch_sub(1, Ordering::AcqRel);
+                return Err(io::Error::other("LightCraft is closing"));
+            }
+            let token = Token;
+            self.spawn(move || {
+                let _token = token;
+                work()
+            })
+        } else {
+            self.spawn(work)
+        }
+    }
+}
+pub fn spawn<F, T>(work: F) -> io::Result<JoinHandle<T>>
+where
+    F: FnOnce() -> T + Send + 'static,
+    T: Send + 'static,
+{
+    Builder::new().spawn_tracked(work)
+}
+pub fn active() -> usize {
+    ACTIVE.load(Ordering::Acquire)
+}
+pub fn closing() -> bool {
+    CLOSING.load(Ordering::Acquire)
+}
+pub fn begin_shutdown() {
+    if cfg!(any(target_os = "aros", test)) {
+        CLOSING.store(true, Ordering::Release);
+    }
+}
+pub fn wait(timeout: Duration) -> bool {
+    let started = Instant::now();
+    while active() != 0 {
+        if started.elapsed() >= timeout {
+            return false;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn detached_work_is_counted_until_completion_and_shutdown_rejects_new_work() {
+        let (tx, rx) = std::sync::mpsc::channel();
+        let handle = std::thread::Builder::new().name("lifecycle-test".into()).spawn_tracked(move || rx.recv().unwrap()).unwrap();
+        assert!(!wait(std::time::Duration::from_millis(10)));
+        assert_eq!(active(), 1);
+        tx.send(7).unwrap();
+        assert_eq!(handle.join().unwrap(), 7);
+        assert!(wait(std::time::Duration::from_secs(1)));
+        begin_shutdown();
+        assert!(std::thread::Builder::new().spawn_tracked(|| ()).is_err());
+        assert!(closing());
+    }
+}
