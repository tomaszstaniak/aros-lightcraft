+
+#[cfg(test)]
+mod aros_launch_tests {
+    use super::aros_paths;
+    fn args(s: &[&str]) -> Vec<String> {
+        s.iter().map(|s| s.to_string()).collect()
+    }
+    fn abs(s: &str) -> String {
+        std::path::absolute(s).unwrap().to_string_lossy().into_owned()
+    }
+    #[test]
+    fn mcp_files_and_optional_connect_are_classified_as_upstream() {
+        let a = aros_paths(args(&["mcp", "sample.png", "--library", "Library"])).unwrap();
+        assert_eq!(a, args(&["mcp", &abs("sample.png"), "--library", &abs("Library")]));
+        let a = aros_paths(args(&["mcp", "--connect", "sample.png"])).unwrap();
+        assert_eq!(a, args(&["mcp", "--connect", &abs("sample.png")]));
+        let a = aros_paths(args(&["mcp", "--connect", "127.0.0.1:7980"])).unwrap();
+        assert_eq!(a, args(&["mcp", "--connect", "127.0.0.1:7980"]));
+    }
+    #[test]
+    fn merge_inputs_preview_and_non_path_values_are_separate() {
+        let a = aros_paths(args(&["merge", "hdr", "a.dng", "--deghost", "low", "b.dng", "--preview", "preview.png"])).unwrap();
+        assert_eq!(a, args(&["merge", "hdr", &abs("a.dng"), "--deghost", "low", &abs("b.dng"), "--preview", &abs("preview.png")]));
+    }
+}
