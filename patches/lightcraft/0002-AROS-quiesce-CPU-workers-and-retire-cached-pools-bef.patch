diff --git a/crates/engine/src/owned_pool.rs b/crates/engine/src/owned_pool.rs
new file mode 100644
index 0000000000000000000000000000000000000000..15b7d918daf75daae958b6860ffaea10a17e8e86
--- /dev/null
+++ b/crates/engine/src/owned_pool.rs
@@ -0,0 +1,49 @@
+//! Explicit lifetime for cached private Rayon pools on platforms that join all pthreads.
+use std::sync::{Arc, Mutex};
+
+struct State {
+    initialized: bool,
+    stopped: bool,
+    pool: Option<Arc<rayon::ThreadPool>>,
+}
+pub(crate) struct PoolSlot(Mutex<State>);
+impl PoolSlot {
+    pub const fn new() -> Self {
+        Self(Mutex::new(State { initialized: false, stopped: false, pool: None }))
+    }
+    pub fn get(&self, create: impl FnOnce() -> Option<rayon::ThreadPool>) -> Option<Arc<rayon::ThreadPool>> {
+        let mut state = self.0.lock().unwrap_or_else(|e| e.into_inner());
+        if state.stopped {
+            return None;
+        }
+        if !state.initialized {
+            state.pool = create().map(Arc::new);
+            state.initialized = true;
+        }
+        state.pool.clone()
+    }
+    pub fn shutdown(&self) {
+        let pool = {
+            let mut state = self.0.lock().unwrap_or_else(|e| e.into_inner());
+            state.stopped = true;
+            state.pool.take()
+        };
+        drop(pool);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn shutdown_retires_pool_and_prevents_recreation() {
+        let slot = PoolSlot::new();
+        let pool = slot.get(|| rayon::ThreadPoolBuilder::new().num_threads(2).build().ok()).unwrap();
+        assert_eq!(pool.install(|| rayon::join(|| 17, || 25)), (17, 25));
+        slot.shutdown();
+        assert!(slot.get(|| panic!("retired pools must not be recreated")).is_none());
+        // Outstanding callers own their lease until the work ends; releasing the last lease drops the pool.
+        assert_eq!(Arc::strong_count(&pool), 1);
+        drop(pool);
+    }
+}
