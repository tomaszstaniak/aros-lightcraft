+[package]
+name = "lightcraft-aros"
+description = "LightCraft on AROS: the egui interface in an Intuition window, through egui-aros"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish = false
+
+# The window, input, renderers, requesters, clipboard, character set and start-up data come
+# from egui-aros (shared by the Craft AROS ports); this crate has no `unsafe` code of its own.
+# Not the workspace lints: their `forbid(unsafe_code)` also rejects the start-up stack record
+# that aros-startup's minimum_stack! macro writes.
+
+[lints.clippy]
+dbg_macro = "warn"
+todo = "warn"
+
+[[bin]]
+name = "LightCraft"
+path = "src/main.rs"
+
+[features]
+default = ["denoise"]
+denoise = ["lightcraft-engine/denoise"]
+
+[dependencies]
+lightcraft-engine = { workspace = true }
+lightcraft-ui-egui = { workspace = true }
+lightcraft-codecs = { workspace = true }
+lightcraft-raster = { workspace = true }
+# stop_renders at shutdown: a demo photo still being generated would keep the process from ending
+lightcraft-scenes = { workspace = true }
+egui = { workspace = true }
+# Built from a pinned egui-aros commit with its crate patches: see the port's scripts/craft.py.
+# OpenGL is compiled in and chosen at run time (CPU, AUTO or GPU).
+egui-aros = { version = "0.1", features = ["asl", "glow"] }
+# Its minimum_stack! macro (egui_aros::startup is the same crate).
+aros-startup = "0.1"
+serde_json = { workspace = true }
+log = { workspace = true }
+
+# The patched rayon-core (see the port's crate patches) can end the global pool's threads, which
+# AROS's pthread library otherwise waits for forever when the program exits.
+[target.'cfg(target_os = "aros")'.dependencies]
+rayon-core = "1.13"
