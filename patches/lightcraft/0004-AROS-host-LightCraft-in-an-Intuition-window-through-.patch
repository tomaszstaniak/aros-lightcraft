index 0000000000000000000000000000000000000000..26cce3c72875cd43a6a981eb62fc9565b2fec36f
--- /dev/null
+++ b/apps/lightcraft-aros/src/services.rs
@@ -0,0 +1,182 @@
+//! The platform services LightCraft uses on AROS: ASL requesters for files and folders, file
+//! writing and PNG encoding. The same contract as the desktop app's `session::services`, without
+//! rfd and the openers of other programs, links and folders, which have no AROS backend here
+//! (`None`: the app treats them as not available). Text goes through the system clipboard by
+//! egui-aros.
+//!
+//! Paths: the program runs in the -nix path mode; requesters speak DOS names, converted at this
+//! edge (egui_aros::startup).
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use egui_aros::WindowHandle;
+use egui_aros::asl::{Select, request};
+use egui_aros::startup::{dos_to_nix, nix_to_dos};
+use lightcraft_ui_egui::Services;
+use lightcraft_ui_egui::i18n::tr;
+use lightcraft_ui_egui::pick::{PickKind, PickRequest};
+
+/// The window the requesters are parented to, set once the window is open (the requester runs on
+/// the main thread, modally, while the loop is inside the service call). The handle holds the
+/// window weakly: after it closes, a requester opens without a parent.
+pub type SharedWindow = Rc<RefCell<Option<WindowHandle>>>;
+
+/// The drawer the last requester ended in, where the next one starts.
+type LastDir = Rc<RefCell<String>>;
+
+/// An AmigaDOS pattern (matched without regard to case) for a list of extensions. asl.library
+/// copies the pattern into a 257-byte gadget without a length check (VectorCraft port): a list too
+/// long for that shows every file instead.
+fn pattern(extensions: &[&str]) -> String {
+    if extensions.is_empty() {
+        return String::new();
+    }
+    let p = format!("#?.({})", extensions.join("|"));
+    if p.len() < 200 { p } else { "#?".to_owned() }
+}
+
+/// The drawer part of a -nix path (`/Work/Photos` for `/Work/Photos/a.jpg`).
+fn dir_part(path: &str) -> &str {
+    match path.rfind('/') {
+        Some(0) | None => "",
+        Some(i) => &path[..i],
+    }
+}
+
+/// Shows a requester and returns the chosen -nix paths (empty: cancelled).
+fn pick(window: &SharedWindow, last: &LastDir, select: Select, title: &str, file: &str, pat: &str) -> Vec<String> {
+    let Some(win) = window.borrow().clone() else { return Vec::new() };
+    let dir = last.borrow().clone();
+    let start = if dir.is_empty() { String::new() } else { nix_to_dos(&dir).unwrap_or_default() };
+    let chosen: Vec<String> = request(&win, select, title, &start, file, pat)
+        .into_iter()
+        .filter_map(|dos| match dos_to_nix(&dos) {
+            Ok(p) => Some(p),
+            Err(e) => {
+                log::warn!("requester: {dos}: {e}");
+                None
+            }
+        })
+        .collect();
+    if let Some(first) = chosen.first() {
+        let drawer = if matches!(select, Select::Drawer) { first.as_str() } else { dir_part(first) };
+        *last.borrow_mut() = drawer.to_owned();
+    }
+    chosen
+}
+
+fn open_files(window: &SharedWindow, last: &LastDir, title: &str, extensions: &[&str]) -> Vec<String> {
+    pick(window, last, Select::OpenMany, title, "", &pattern(extensions))
+}
+
+fn open_file(window: &SharedWindow, last: &LastDir, title: &str, extensions: &[&str]) -> Vec<String> {
+    pick(window, last, Select::Open, title, "", &pattern(extensions))
+}
+
+fn save_file(window: &SharedWindow, last: &LastDir, title: &str, extensions: &[&str], name: &str) -> Option<String> {
+    pick(window, last, Select::Save, title, name, &pattern(extensions)).into_iter().next()
+}
+
+fn folder(window: &SharedWindow, last: &LastDir, title: &str) -> Option<String> {
+    pick(window, last, Select::Drawer, title, "", "").into_iter().next()
+}
+
+/// The services for this host.
+pub fn aros(window: SharedWindow) -> Services {
+    let last: LastDir = Rc::new(RefCell::new(String::new()));
+    let (w, l) = (window.clone(), last.clone());
+    // Commands' dialogs: the desktop app shows them on a thread of their own and answers later;
+    // an ASL requester runs here on the main task, and the answer is ready when it closes.
+    let picker = Box::new(move |req: PickRequest| {
+        let exts: &[&str] = req.filter.as_ref().map_or(&[], |(_, e)| e);
+        let title = req.title.clone().unwrap_or_default();
+        let paths = match req.kind {
+            PickKind::Files => open_files(&w, &l, &title, exts),
+            PickKind::File => open_file(&w, &l, &title, exts),
+            PickKind::Folder => folder(&w, &l, &title).into_iter().collect(),
+            PickKind::Save => save_file(&w, &l, &title, exts, req.file_name.as_deref().unwrap_or("")).into_iter().collect(),
+        };
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = tx.send(paths);
+        Ok(rx)
+    });
+    macro_rules! files {
+        ($title:expr, $exts:expr) => {{
+            let (w, l) = (window.clone(), last.clone());
+            Some(Box::new(move || open_files(&w, &l, tr($title), $exts)) as lightcraft_ui_egui::PickFiles)
+        }};
+    }
+    macro_rules! file {
+        ($title:expr, $exts:expr) => {{
+            let (w, l) = (window.clone(), last.clone());
+            Some(Box::new(move || open_file(&w, &l, tr($title), $exts)) as lightcraft_ui_egui::PickFiles)
+        }};
+    }
+    macro_rules! save {
+        ($title:expr, $exts:expr) => {{
+            let (w, l) = (window.clone(), last.clone());
+            Some(Box::new(move |name: &str| save_file(&w, &l, tr($title), $exts, name)) as lightcraft_ui_egui::SaveFile)
+        }};
+    }
+    let (wf, lf) = (window.clone(), last.clone());
+    let (wl, ll) = (window.clone(), last.clone());
+    Services {
+        // the places of the Local browser: AROS has no home folder
+        local_places: Some(vec![("RAM Disk".to_owned(), "/RAM".to_owned()), ("System".to_owned(), "/SYS".to_owned())]),
+        picker: Some(picker),
+        pick_files: files!("Import Photos", lightcraft_engine::import::EXTENSIONS),
+        pick_denoise_model: file!("Choose a Denoise Model", &["onnx"]),
+        pick_model_file: file!("Add a Face Recognition Model", &["onnx"]),
+        pick_preset_files: files!("Import Presets", &["lcpreset", "xmp", "lrtemplate", "zip", "dng", "lmp", "mplumpack", "cube"]),
+        pick_tracklog: file!("Auto-Tag from Tracklog", &["gpx"]),
+        pick_display_profile: file!("Choose Monitor Profile", &["icc", "icm"]),
+        screen_profile: None,
+        save_preset_file: save!("Export Presets", &["lcpreset"]),
+        pick_keyword_list: file!("Import Keywords", &["txt", "utf8"]),
+        save_keyword_list: save!("Export Keywords", &["txt"]),
+        pick_curve_preset_files: files!("Import Point Curve Presets", &["lccurve", "json"]),
+        save_curve_preset_file: save!("Export Point Curve Presets", &["lccurve"]),
+        pick_slideshow_templates: files!("Import Slideshow Templates", &["json"]),
+        save_slideshow_template: save!("Export Slideshow Template", &["json"]),
+        pick_print_templates: files!("Import Print Templates", &[lightcraft_engine::print::template::FILE_EXT]),
+        save_print_template: save!("Export Print Template", &[lightcraft_engine::print::template::FILE_EXT]),
+        // atomic (temp file + sync + rename): a failed write never leaves a truncated file
+        write_shared: Some(std::sync::Arc::new(lightcraft_engine::export::write_file)),
+        write: Some(Box::new(lightcraft_engine::export::write_file)),
+        write_new: Some(Box::new(lightcraft_engine::export::write_file_new)),
+        png: Some(Box::new(|img: &lightcraft_raster::Rgba8| {
+            lightcraft_codecs::encode_png(&lightcraft_codecs::EncodeImage::rgba8(img), &lightcraft_codecs::EncodeMeta::default()).unwrap_or_default()
+        })),
+        reveal: None,
+        log_file: lightcraft_engine::config::config_dir().map(|d| d.join("LightCraft.log").display().to_string()),
+        pick_folder: Some(Box::new(move || folder(&wf, &lf, tr("Open Library")))),
+        pick_lightroom_catalog: Some(Box::new(move || open_file(&wl, &ll, tr("Import Lightroom Catalog"), &["lrcat", "zip"]).into_iter().next())),
+        open_url: None,
+        open_with: None,
+        open_all_with: None,
+        check_editor: None,
+        backup_library: None,
+        restore_library: None,
+        system_theme: None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn path_parts() {
+        assert_eq!(dir_part("/Work/Photos/a.jpg"), "/Work/Photos");
+        assert_eq!(dir_part("/RAM"), "");
+        assert_eq!(dir_part("a.jpg"), "");
+    }
+
+    #[test]
+    fn patterns_fit_the_requester() {
+        assert_eq!(pattern(&["gpx"]), "#?.(gpx)");
+        assert_eq!(pattern(&[]), "");
+        assert!(pattern(lightcraft_engine::import::EXTENSIONS).len() < 200);
+    }
+}
