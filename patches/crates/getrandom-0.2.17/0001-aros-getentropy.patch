From: LightCraft AROS port
Subject: [PATCH] getrandom 0.2.17: use matched rust-aros getentropy

Why: the x86_64/v11 libc-aros profile provides serialized jitterentropy via
getentropy. Use bounded 256-byte calls and propagate failure; do not read
uninitialized bytes, use time-based pseudo-randomness, or conflate the
incompatible custom callback APIs of getrandom 0.2/0.3/0.4.
Scope: AROS only, exact crates.io 0.2.17 archive/checksum in crates.json.
Upstream-status: local port, not submitted.
Verification: native compile/runtime pending; retain failure reporting.
---
diff --git a/src/aros.rs b/src/aros.rs
new file mode 100644
index 0000000..83301f8
--- /dev/null
+++ b/src/aros.rs
@@ -0,0 +1,11 @@
+use crate::Error;
+use core::mem::MaybeUninit;
+pub fn getrandom_inner(dest: &mut [MaybeUninit<u8>]) -> Result<(), Error> {
+    for chunk in dest.chunks_mut(256) {
+        // SAFETY: writable chunk, including uninitialized bytes; getentropy initializes all on success.
+        if unsafe { libc::getentropy(chunk.as_mut_ptr().cast(), chunk.len()) } != 0 {
+            return Err(Error::UNSUPPORTED);
+        }
+    }
+    Ok(())
+}
diff --git a/src/lib.rs b/src/lib.rs
index 4d2e4ea..a5182ef 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -235,7 +235,9 @@ pub use crate::error::Error;
 // The function MUST NOT ever write uninitialized bytes into `dest`,
 // regardless of what value it returns.
 cfg_if! {
-    if #[cfg(any(target_os = "haiku", target_os = "redox", target_os = "nto", target_os = "aix"))] {
+    if #[cfg(target_os = "aros")] {
